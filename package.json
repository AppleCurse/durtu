{
  "name": "durtu",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "durtu-app"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=durtu-app",
    "build": "npm run build --workspace=durtu-app",
    "start": "npm run start --workspace=durtu-app",
    "lint": "npm run lint --workspace=durtu-app",
    "test": "npm run test --workspace=durtu-app && node tests/engine.test.js",
    "test:app": "npm run test --workspace=durtu-app",
    "test:legacy": "node tests/engine.test.js",
    "verify": "npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  }
}
